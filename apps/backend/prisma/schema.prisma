generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum BrandStatus {
  ACTIVE
  INACTIVE
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

model User {
  id                   String        @id @default(uuid()) @db.Uuid
  fullName             String        @map("full_name") @db.VarChar(100)
  email                String        @unique @db.VarChar(255)
  passwordHash         String        @map("password_hash")
  role                 UserRole      @default(CUSTOMER)
  accountStatus        AccountStatus @default(PENDING_VERIFICATION) @map("account_status")
  emailVerifiedAt      DateTime?     @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt          DateTime?     @map("last_login_at") @db.Timestamptz(6)
  profilePhotoUrl      String?       @map("profile_photo_url")
  profilePhotoPublicId String?       @map("profile_photo_public_id")
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime?     @map("deleted_at") @db.Timestamptz(6)

  verificationTokens VerificationToken[]
  sessions           Session[]
  customerAddresses CustomerAddress[]
  productReviews ProductReview[]

  @@index([role], map: "idx_users_role")
  @@index([accountStatus], map: "idx_users_account_status")
  @@index([deletedAt], map: "idx_users_deleted_at")
  @@map("users")
}

model CustomerAddress {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  label        String   @db.VarChar(50)
  recipientName String  @map("recipient_name") @db.VarChar(100)
  phone        String   @db.VarChar(30)
  addressLine  String   @map("address_line") @db.Text
  district     String   @db.VarChar(100)
  city         String   @db.VarChar(100)
  province     String   @db.VarChar(100)
  postalCode   String   @map("postal_code") @db.VarChar(10)
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId], map: "idx_customer_addresses_user_id")
  @@index([userId, isDefault], map: "idx_customer_addresses_user_default")
  @@map("customer_addresses")
}

model VerificationToken {
  id          String                @id @default(uuid()) @db.Uuid
  userId      String                @map("user_id") @db.Uuid
  tokenLookup String                @unique @map("token_lookup")
  tokenHash   String                @unique @map("token_hash")
  type        VerificationTokenType @default(EMAIL_VERIFICATION)
  expiresAt   DateTime              @map("expires_at") @db.Timestamptz(6)
  usedAt      DateTime?             @map("used_at") @db.Timestamptz(6)
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId], map: "idx_verification_tokens_user_id")
  @@index([type], map: "idx_verification_tokens_type")
  @@index([expiresAt], map: "idx_verification_tokens_expires_at")
  @@map("verification_tokens")
}

model Session {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenLookup String    @unique @map("token_lookup")
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId], map: "idx_sessions_user_id")
  @@index([expiresAt], map: "idx_sessions_expires_at")
  @@index([revokedAt], map: "idx_sessions_revoked_at")
  @@map("sessions")
}

model Brand {
  id        String      @id @default(uuid()) @db.Uuid
  name      String      @db.VarChar(100)
  slug      String      @unique @db.VarChar(120)
  status    BrandStatus @default(ACTIVE)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@index([name], map: "idx_brands_name")
  @@index([status], map: "idx_brands_status")
  @@map("brands")
}

model Supplier {
  id        String         @id @default(uuid()) @db.Uuid
  name      String         @db.VarChar(100)
  slug      String         @unique @db.VarChar(120)
  status    SupplierStatus @default(ACTIVE)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@index([name], map: "idx_suppliers_name")
  @@index([status], map: "idx_suppliers_status")
  @@map("suppliers")
}

model Category {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @db.VarChar(100)
  slug      String     @unique @db.VarChar(120)
  parentId  String?    @map("parent_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  products  Product[]

  @@index([parentId], map: "idx_categories_parent_id")
  @@index([name], map: "idx_categories_name")
  @@map("categories")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  sku         String   @unique @db.VarChar(100)
  name        String   @db.VarChar(150)
  slug        String   @unique @db.VarChar(180)
  description String?  @db.Text
  price       Int
  brandId     String   @map("brand_id") @db.Uuid
  supplierId  String   @map("supplier_id") @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  brand       Brand    @relation(fields: [brandId], references: [id])
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  category    Category @relation(fields: [categoryId], references: [id])
  media ProductMedia[]
  reviews ProductReview[]

  @@index([brandId], map: "idx_products_brand_id")
  @@index([supplierId], map: "idx_products_supplier_id")
  @@index([categoryId], map: "idx_products_category_id")
  @@index([name], map: "idx_products_name")
  @@map("products")
}

model ProductMedia {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  url       String
  publicId  String   @map("public_id")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id])

  @@index([productId], map: "idx_product_media_product_id")
  @@index([productId, sortOrder], map: "idx_product_media_product_sort")
  @@map("product_media")
}

model ProductReview {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  rating     Int
  reviewText String?  @map("review_text") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([productId], map: "idx_product_reviews_product_id")
  @@index([userId], map: "idx_product_reviews_user_id")
  @@index([productId, createdAt], map: "idx_product_reviews_product_created")
  @@map("product_reviews")
}