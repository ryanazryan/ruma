generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id                   String        @id @default(uuid()) @db.Uuid
  fullName             String        @map("full_name") @db.VarChar(100)
  email                String        @unique @db.VarChar(255)
  passwordHash         String        @map("password_hash")
  role                 UserRole      @default(CUSTOMER)
  accountStatus        AccountStatus @default(PENDING_VERIFICATION) @map("account_status")
  emailVerifiedAt      DateTime?     @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt          DateTime?     @map("last_login_at") @db.Timestamptz(6)
  profilePhotoUrl      String?       @map("profile_photo_url")
  profilePhotoPublicId String?       @map("profile_photo_public_id")
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime?     @map("deleted_at") @db.Timestamptz(6)

  verificationTokens VerificationToken[]
  sessions           Session[]
  customerAddresses CustomerAddress[]

  @@index([role], map: "idx_users_role")
  @@index([accountStatus], map: "idx_users_account_status")
  @@index([deletedAt], map: "idx_users_deleted_at")
  @@map("users")
}

model CustomerAddress {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  label        String   @db.VarChar(50)
  recipientName String  @map("recipient_name") @db.VarChar(100)
  phone        String   @db.VarChar(30)
  addressLine  String   @map("address_line") @db.Text
  district     String   @db.VarChar(100)
  city         String   @db.VarChar(100)
  province     String   @db.VarChar(100)
  postalCode   String   @map("postal_code") @db.VarChar(10)
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId], map: "idx_customer_addresses_user_id")
  @@index([userId, isDefault], map: "idx_customer_addresses_user_default")
  @@map("customer_addresses")
}

model VerificationToken {
  id          String                @id @default(uuid()) @db.Uuid
  userId      String                @map("user_id") @db.Uuid
  tokenLookup String                @unique @map("token_lookup")
  tokenHash   String                @unique @map("token_hash")
  type        VerificationTokenType @default(EMAIL_VERIFICATION)
  expiresAt   DateTime              @map("expires_at") @db.Timestamptz(6)
  usedAt      DateTime?             @map("used_at") @db.Timestamptz(6)
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId], map: "idx_verification_tokens_user_id")
  @@index([type], map: "idx_verification_tokens_type")
  @@index([expiresAt], map: "idx_verification_tokens_expires_at")
  @@map("verification_tokens")
}

model Session {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenLookup String    @unique @map("token_lookup")
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId], map: "idx_sessions_user_id")
  @@index([expiresAt], map: "idx_sessions_expires_at")
  @@index([revokedAt], map: "idx_sessions_revoked_at")
  @@map("sessions")
}