generator client {
provider = "prisma-client-js"
}

datasource db {
provider = "postgresql"
url = env("DATABASE_URL")
}

enum UserRole {
CUSTOMER
ADMIN
}

enum BrandStatus {
ACTIVE
INACTIVE
}

enum AccountStatus {
PENDING_VERIFICATION
ACTIVE
}

enum VerificationTokenType {
EMAIL_VERIFICATION
PASSWORD_RESET
}

enum SupplierStatus {
ACTIVE
INACTIVE
}

enum OrderStatus {
CREATED
PENDING_PAYMENT
PAID
PROCESSING
SHIPPED
DELIVERED
COMPLETED
CANCELLED
}

enum NotificationType {
ACCOUNT
ORDER
PAYMENT
}

enum MembershipStatus {
NON_MEMBER
MEMBER
}

model User {
id String @id @default(uuid()) @db.Uuid
fullName String @map("full_name") @db.VarChar(100)
email String @unique @db.VarChar(255)
passwordHash String @map("password_hash")
role UserRole @default(CUSTOMER)
accountStatus AccountStatus @default(PENDING_VERIFICATION) @map("account_status")
emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(6)
profilePhotoUrl String? @map("profile_photo_url")
profilePhotoPublicId String? @map("profile_photo_public_id")

membershipStatus MembershipStatus @default(NON_MEMBER) @map("membership_status")
membershipActivatedAt DateTime? @map("membership_activated_at") @db.Timestamptz(6)

createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

verificationTokens VerificationToken[]
sessions Session[]
customerAddresses CustomerAddress[]
productReviews ProductReview[]
wishlistItems WishlistItem[]
orders Order[]
notifications Notification[]

@@index([role], map: "idx_users_role")
@@index([accountStatus], map: "idx_users_account_status")
@@index([deletedAt], map: "idx_users_deleted_at")
@@map("users")
}

model CustomerAddress {
id String @id @default(uuid()) @db.Uuid
userId String @map("user_id") @db.Uuid
label String @db.VarChar(50)
recipientName String @map("recipient_name") @db.VarChar(100)
phone String @db.VarChar(30)
addressLine String @map("address_line") @db.Text
district String @db.VarChar(100)
city String @db.VarChar(100)
province String @db.VarChar(100)
postalCode String @map("postal_code") @db.VarChar(10)
isDefault Boolean @default(false) @map("is_default")
createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

user User @relation(fields: [userId], references: [id])

@@index([userId], map: "idx_customer_addresses_user_id")
@@index([userId, isDefault], map: "idx_customer_addresses_user_default")
@@map("customer_addresses")
}

model VerificationToken {
id String @id @default(uuid()) @db.Uuid
userId String @map("user_id") @db.Uuid
tokenLookup String @unique @map("token_lookup")
tokenHash String @unique @map("token_hash")
type VerificationTokenType @default(EMAIL_VERIFICATION)
expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
usedAt DateTime? @map("used_at") @db.Timestamptz(6)
createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

user User @relation(fields: [userId], references: [id])

@@index([userId], map: "idx_verification_tokens_user_id")
@@index([type], map: "idx_verification_tokens_type")
@@index([expiresAt], map: "idx_verification_tokens_expires_at")
@@map("verification_tokens")
}

model Session {
id String @id @default(uuid()) @db.Uuid
userId String @map("user_id") @db.Uuid
tokenLookup String @unique @map("token_lookup")
tokenHash String @unique @map("token_hash")
expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

user User @relation(fields: [userId], references: [id])

@@index([userId], map: "idx_sessions_user_id")
@@index([expiresAt], map: "idx_sessions_expires_at")
@@index([revokedAt], map: "idx_sessions_revoked_at")
@@map("sessions")
}

model Brand {
id String @id @default(uuid()) @db.Uuid
name String @db.VarChar(100)
slug String @unique @db.VarChar(120)
status BrandStatus @default(ACTIVE)
createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

products Product[]

@@index([name], map: "idx_brands_name")
@@index([status], map: "idx_brands_status")
@@map("brands")
}

model Supplier {
id String @id @default(uuid()) @db.Uuid
name String @db.VarChar(100)
slug String @unique @db.VarChar(120)
status SupplierStatus @default(ACTIVE)
createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

products Product[]

@@index([name], map: "idx_suppliers_name")
@@index([status], map: "idx_suppliers_status")
@@map("suppliers")
}

model Category {
id String @id @default(uuid()) @db.Uuid
name String @db.VarChar(100)
slug String @unique @db.VarChar(120)
parentId String? @map("parent_id") @db.Uuid
createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

parent Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
children Category[] @relation("CategoryHierarchy")
products Product[]

@@index([parentId], map: "idx_categories_parent_id")
@@index([name], map: "idx_categories_name")
@@map("categories")
}

model Product {
id String @id @default(uuid()) @db.Uuid
sku String @unique @db.VarChar(100)
name String @db.VarChar(150)
slug String @unique @db.VarChar(180)
description String? @db.Text
price Int
brandId String @map("brand_id") @db.Uuid
supplierId String @map("supplier_id") @db.Uuid
categoryId String @map("category_id") @db.Uuid
createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

brand Brand @relation(fields: [brandId], references: [id])
supplier Supplier @relation(fields: [supplierId], references: [id])
category Category @relation(fields: [categoryId], references: [id])

media ProductMedia[]
reviews ProductReview[]
wishlistItems WishlistItem[]
orderItems OrderItem[]

@@index([brandId], map: "idx_products_brand_id")
@@index([supplierId], map: "idx_products_supplier_id")
@@index([categoryId], map: "idx_products_category_id")
@@index([name], map: "idx_products_name")
@@map("products")
}

model ProductMedia {
id String @id @default(uuid()) @db.Uuid
productId String @map("product_id") @db.Uuid
url String
publicId String @map("public_id")
sortOrder Int @default(0) @map("sort_order")
createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

product Product @relation(fields: [productId], references: [id])

@@index([productId], map: "idx_product_media_product_id")
@@index([productId, sortOrder], map: "idx_product_media_product_sort")
@@map("product_media")
}

model ProductReview {
id String @id @default(uuid()) @db.Uuid
productId String @map("product_id") @db.Uuid
userId String @map("user_id") @db.Uuid
rating Int
reviewText String? @map("review_text") @db.Text
createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

product Product @relation(fields: [productId], references: [id])
user User @relation(fields: [userId], references: [id])

@@index([productId], map: "idx_product_reviews_product_id")
@@index([userId], map: "idx_product_reviews_user_id")
@@index([productId, createdAt], map: "idx_product_reviews_product_created")
@@map("product_reviews")
}

model WishlistItem {
id String @id @default(uuid()) @db.Uuid
userId String @map("user_id") @db.Uuid
productId String @map("product_id") @db.Uuid
createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

user User @relation(fields: [userId], references: [id])
product Product @relation(fields: [productId], references: [id])

@@unique([userId, productId], map: "uq_wishlist_items_user_product")
@@index([userId], map: "idx_wishlist_items_user_id")
@@index([productId], map: "idx_wishlist_items_product_id")
@@map("wishlist_items")
}

model Order {
id String @id @default(uuid()) @db.Uuid
userId String @map("user_id") @db.Uuid
orderNumber String @unique @map("order_number") @db.VarChar(30)
status OrderStatus @default(CREATED)
totalAmount Int @map("total_amount")

shippingRecipientName String @map("shipping_recipient_name") @db.VarChar(100)
shippingPhone String @map("shipping_phone") @db.VarChar(30)
shippingAddressLine String @map("shipping_address_line") @db.Text
shippingDistrict String @map("shipping_district") @db.VarChar(100)
shippingCity String @map("shipping_city") @db.VarChar(100)
shippingProvince String @map("shipping_province") @db.VarChar(100)
shippingPostalCode String @map("shipping_postal_code") @db.VarChar(10)

createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

user User @relation(fields: [userId], references: [id])
items OrderItem[]

@@index([userId], map: "idx_orders_user_id")
@@index([userId, createdAt], map: "idx_orders_user_created")
@@index([status], map: "idx_orders_status")
@@map("orders")
}

model OrderItem {
id String @id @default(uuid()) @db.Uuid
orderId String @map("order_id") @db.Uuid
productId String @map("product_id") @db.Uuid
productName String @map("product_name") @db.VarChar(150)
unitPrice Int @map("unit_price")
quantity Int
subtotal Int

order Order @relation(fields: [orderId], references: [id])
product Product @relation(fields: [productId], references: [id])

@@index([orderId], map: "idx_order_items_order_id")
@@index([productId], map: "idx_order_items_product_id")
@@map("order_items")
}

model Notification {
id String @id @default(uuid()) @db.Uuid
userId String @map("user_id") @db.Uuid
type NotificationType
title String @db.VarChar(150)
message String @db.Text
isRead Boolean @default(false) @map("is_read")
createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

user User @relation(fields: [userId], references: [id])

@@index([userId], map: "idx_notifications_user_id")
@@index([userId, createdAt], map: "idx_notifications_user_created")
@@index([userId, isRead], map: "idx_notifications_user_read")
@@map("notifications")
}
